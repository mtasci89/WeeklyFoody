TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_USER_ID=
TELEGRAM_RECIPIENT_CHAT_IDS=

TIMEZONE=Europe/Istanbul
WEEKLY_PLAN_DAY=sunday
WEEKLY_PLAN_TIME=10:00
# Her haftaki menuye girecek, kutuphanede olmayan yeni yemek sayisi (ev kurali ezer)
WEEKLY_NEW_DISHES=2

DATABASE_URL=sqlite:///data/mealplanner.db

LLM_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Ucretsiz anahtar: aistudio.google.com -> Get API key. Faturalandirma
# baglanmadigi surece ucretsiz katmandasin; baglarsan tum kullanim ucretlenir.
GEMINI_API_KEY=
# Model degistirirsen once `python -m app.cli check-agent` ile dogrula. Model
# kapatilmissa cikti Google'in onerdigi yeni modeli soyler.
GEMINI_MODEL=gemini-3.8-flash
# Ana model mesgul (503), kotasi dolu (429) ya da kapatilmis (404) ise sirayla
# denenir. Hangilerinin calistigini check-agent tek tek gosterir; calismayani
# listeden cikarabilirsin.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Konusma ajani. AGENT_PROVIDER=gemini ucretsiz katmanla calisir ve
# GEMINI_API_KEY'i kullanir. AGENT_PROVIDER=anthropic ucretlidir ve
# ANTHROPIC_API_KEY ister. Secilen saglayicinin anahtari yoksa bot eski niyet
# yonlendiricisine geri duser.
AGENT_ENABLED=true
AGENT_PROVIDER=gemini
# Yalnizca AGENT_PROVIDER=anthropic icin:
ANTHROPIC_API_KEY=
# Maliyet en cok buradan degisir: opus-5-5 > sonnet-5-5 > haiku-5-5.
# Pahali gelirse once bunu dusur.
ANTHROPIC_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
# Web arama: ajan kutuphanede olmayan tarifi kendisi arayip aday olarak
# ekleyebilir. Her arama ucretlendirilir; max_uses tur basina sinirdir.
AGENT_WEB_SEARCH_ENABLED=true
AGENT_WEB_SEARCH_MAX_USES=5
# Onbellek omru. "1h" daha ucuz ama extended-cache-ttl beta erisimi ister;
# istek reddediliyorsa "5m"de birak.
AGENT_CACHE_TTL=5m

DEFAULT_SERVINGS=4
MEAL_SLOTS=dinner
MEAL_COURSE_ROLES=main,meze,meze,side
PANTRY_MODE=exclude
LOG_LEVEL=INFO

RECIPE_DISCOVERY_ENABLED=true
RECIPE_DISCOVERY_DAY=saturday
RECIPE_DISCOVERY_TIME=18:00
RECIPE_DISCOVERY_LIMIT_PER_CATEGORY=2
# Separate custom queries with semicolon or pipe.
RECIPE_DISCOVERY_QUERIES=

# Panel acilacaksa WEB_PANEL_TOKEN zorunludur; tokensiz baslamaz.
# Host'u 127.0.0.1 disina almadan once token'i mutlaka ata.
WEB_PANEL_ENABLED=false
WEB_PANEL_HOST=127.0.0.1
WEB_PANEL_PORT=8000
WEB_PANEL_TOKEN=

# Foody Android uygulamasinin HTTPS API'si. Elle doldurma:
# `python -m app.cli uygulama-hazirla --adres https://SUNUCU_IP:8443` anahtari ve
# sertifikayi uretip bu satirlari kendisi yazar (deploy/uygulama-ac.sh).
APP_API_ENABLED=false
APP_API_HOST=0.0.0.0
APP_API_PORT=8443
APP_API_TOKEN=
APP_API_PUBLIC_URL=
